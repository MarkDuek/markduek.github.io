---
import Document from "./Document.astro";

interface Props {
  title: string;
  description: string;
}
---

<Document {...Astro.props}>
  <a class="skip-link" href="#main">Skip to content</a>
  <header>
    <nav aria-label="Main navigation">
      <a href="/">Mark Duek</a>
      <a href="/about/">About</a>
      <a href="/projects/">Projects</a>
      <a href="/cv/">CV</a>
    </nav>
  </header>
  <main id="main">
    <slot />
  </main>
</Document>

<style>
  header,
  main {
    width: min(70rem, 100% - 2rem);
    margin-inline: auto;
  }

  header {
    padding-block: 1.5rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  main {
    padding-block: 2rem;
  }

  .skip-link {
    position: absolute;
    top: 0;
    left: 1rem;
    padding: 0.5rem;
    background: white;
    transform: translateY(-100%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }
</style>
