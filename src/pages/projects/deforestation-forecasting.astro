      const sections = links
        .map((link) => document.querySelector<HTMLElement>(link.hash))
        .filter((section): section is HTMLElement => section !== null);
      const updateContents = () => {
        contents.hidden = header.getBoundingClientRect().bottom > 0;
        let current = sections[0];
        for (const section of sections) {
          if (section.getBoundingClientRect().top <= innerHeight * 0.2) current = section;
        }
        links.forEach((link) => link.classList.toggle("active", link.hash === `#${current?.id}`));
      };
      addEventListener("scroll", updateContents, { passive: true });
      updateContents();
    }
