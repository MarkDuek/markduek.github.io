  figcaption::before { content: "Fig. " counter(figure) " — "; }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: .875rem; }
  th, td { padding: .6rem; border-bottom: 1px solid #b9bdb5; text-align: right; }
