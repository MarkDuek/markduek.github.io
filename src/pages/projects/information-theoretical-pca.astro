  .title-block, .project-meta, section, figure { width: min(42rem, 100%); margin-inline: auto; }
  .project-info { display: grid; grid-template-columns: 1fr auto; gap: .125rem 1rem; margin-bottom: .75rem; font: 1.125rem/1.3 Georgia, "Times New Roman", serif; }
  .project-info em { grid-column: 1 / -1; }
  h1, h2, h3, p { font-family: Georgia, "Times New Roman", serif; }
