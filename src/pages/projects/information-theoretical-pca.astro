  h2 { margin: 0 0 1rem; color: var(--accent); font-size: 1.5rem; }
  h2 { scroll-margin-top: 2rem; }
  .project-meta { margin-bottom: 6rem; }
  .lede { max-width: 40rem; font-size: 1.25rem; line-height: 1.3; font-style: italic; }
  .downloads { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; font-size: .875rem; font-weight: 700; }
  .downloads a, a:hover, a:focus-visible { color: var(--accent); }
  section { margin-block: 6rem; font-size: 1.125rem; line-height: 1.45; }
  section p { text-align: justify; }
  figure { counter-increment: figure; margin-block: 4rem; }
  img { display: block; width: 100%; max-height: 48rem; object-fit: contain; }
