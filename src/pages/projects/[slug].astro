---
import SiteLayout from "../../layouts/SiteLayout.astro";

export const projects = {
  "anomaly-detection-benchmark": { title: "Anomaly Detection Benchmark", description: "Benchmarking anomaly-detection methods." },
};

export function getStaticPaths() {
  return Object.entries(projects).map(([slug, project]) => ({ params: { slug }, props: { project } }));
}

const { project } = Astro.props;
---

<SiteLayout title={`${project.title} — Mark Duek`} description={project.description}>
  <h1>{project.title}</h1>
  <p>{project.description}</p>
  <p>Project details coming soon.</p>
</SiteLayout>
